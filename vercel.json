{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "frontend",
  "functions": {
    "api/places.mjs": {
      "maxDuration": 15
    },
    "api/place.mjs": {
      "maxDuration": 15
    },
    "api/route.mjs": {
      "maxDuration": 30
    }
  },
  "cleanUrls": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
